# API (NestJS + Prisma). Server side only
NODE_ENV=
JWT_SECRET=
JWT_EXPIRES_IN=
# Model key — keep here (not in apps/web). Choose MODEL_* (api) OR AI_PROVIDER_* (ai-agent), not both.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
# Must match POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB in .env (root)
DATABASE_URL=
REDIS_URL=
PORT=
# NestJS Observe telemetry. Run `npx @nestjs/observe link` to populate.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=